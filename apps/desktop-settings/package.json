    "@pinia/testing": "^1.0.3",
    "@types/node": "^24.0.0",
    "@unocss/reset": "^66.5.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "electron": "^37.2.0",
    "electron-vite": "^4.0.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "typescript": "^5.8.3",
    "unocss": "^66.5.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.0.0"
