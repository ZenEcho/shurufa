{
  "name": "shurufa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @shurufa/desktop-settings dev",
    "dev:desktop": "pnpm --filter @shurufa/desktop-settings dev",
    "dev:service": "cargo run --manifest-path rust/Cargo.toml -p ime-service",
    "dev:service:oneshot": "cargo run --manifest-path rust/Cargo.toml -p ime-service -- --oneshot",
    "dev:all": "concurrently -k -n desktop,service -c blue,green \"pnpm dev:desktop\" \"pnpm dev:service\"",
    "build": "pnpm --filter @shurufa/desktop-settings build",
    "typecheck": "pnpm --filter @shurufa/desktop-settings typecheck",
    "check:rust": "cargo check --manifest-path rust/Cargo.toml",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:typing": "powershell -ExecutionPolicy Bypass -File .\\scripts\\test-typing-mvp.ps1",
    "verify:mvp": "powershell -ExecutionPolicy Bypass -File .\\scripts\\verify-mvp.ps1",
    "build:windows-tsf": "cargo build --manifest-path rust/Cargo.toml -p windows-tsf --release",
    "install:windows-tsf:dev": "powershell -ExecutionPolicy Bypass -File .\\rust\\native\\windows-tsf\\scripts\\install-ime-dev.ps1",
    "uninstall:windows-tsf:dev": "powershell -ExecutionPolicy Bypass -File .\\rust\\native\\windows-tsf\\scripts\\uninstall-ime-dev.ps1",
    "test:windows-tsf:mvp": "powershell -ExecutionPolicy Bypass -File .\\scripts\\test-windows-tsf-mvp.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
